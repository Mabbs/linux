#!/usr/bin/awk -f
# mdhl -- Highlight Markdown in terminal with ANSI colors

BEGIN {
    ESC = "\033"
    RESET    = ESC "[0m"
    BOLD     = ESC "[1m"
    DIM      = ESC "[2m"
    ITALIC   = ESC "[3m"
    UNDERLINE= ESC "[4m"
    STRIKE   = ESC "[9m"

    RED      = ESC "[31m"
    GREEN    = ESC "[32m"
    YELLOW   = ESC "[33m"
    BLUE     = ESC "[34m"
    MAGENTA  = ESC "[35m"
    CYAN     = ESC "[36m"
    WHITE    = ESC "[37m"

    # ---------- 占位符（不可见控制字符，永不与 Markdown 冲突）----------
    P_RESET     = "\001"
    P_BOLD      = "\002"
    P_DIM       = "\003"
    P_ITALIC    = "\004"
    P_UNDERLINE = "\005"
    P_STRIKE    = "\006"
    P_RED       = "\007"
    P_GREEN     = "\010"
    P_YELLOW    = "\013"   # \013 = VT
    P_BLUE      = "\014"   # \014 = FF
    P_MAGENTA   = "\016"   # \016 = SO
    P_CYAN      = "\017"   # \017 = SI
    P_WHITE     = "\020"   # \020 = DLE
    P_CODE_MARK = "\023"   # \023 = DC3 用于代码保护

    STYLE_START_MARKS = P_BOLD P_DIM P_ITALIC P_UNDERLINE P_STRIKE \
                        P_RED P_GREEN P_YELLOW P_BLUE P_MAGENTA P_CYAN P_WHITE
}

{
    rawline = $0
    trimmed = rawline
    sub(/^[[:space:]]+/, "", trimmed)

    # 代码块切换（fence 判断必须先于空行判断，保证块内空白行原样保留）
    if (trimmed ~ /^```/ || trimmed ~ /^~~~/) {
        in_code = !in_code
        print DIM rawline RESET
        next
    }

    if (in_code) { print WHITE rawline RESET; next }

    # 空行 / 纯空白行：原样输出
    if (trimmed == "") { print rawline; next }

    # 标题
    if (match(trimmed, /^##?#?#?#?#? /)) {
        level = RLENGTH - 1
        if      (level == 1) color = BOLD RED
        else if (level == 2) color = BOLD GREEN
        else if (level == 3) color = BOLD YELLOW
        else if (level == 4) color = BOLD BLUE
        else if (level == 5) color = BOLD MAGENTA
        else                 color = BOLD CYAN
        print color rawline RESET
        next
    }

    # 水平线
    hr = trimmed
    gsub(/[[:space:]]/, "", hr)
    if (hr ~ /^---+$/ || hr ~ /^\*\*\*+$/ || hr ~ /^___+$/) {
        print DIM MAGENTA rawline RESET
        next
    }

    # 引用
    if (trimmed ~ /^>/) { print DIM BLUE rawline RESET; next }

    # 无序列表
    if (trimmed ~ /^[-*+] /) {
        indent = rawline; sub(/[^[:space:]].*$/, "", indent)
        marker = substr(trimmed, 1, 1)
        rest = trimmed; sub(/^.[[:space:]]+/, "", rest)
        print indent BOLD GREEN marker RESET " " inline_highlight(rest)
        next
    }

    # 有序列表
    if (trimmed ~ /^[0-9]+\. /) {
        indent = rawline; sub(/[^[:space:]].*$/, "", indent)
        match(trimmed, /^[0-9]+\./)
        marker = substr(trimmed, 1, RLENGTH)
        rest = substr(trimmed, RLENGTH+1); sub(/^[[:space:]]+/, "", rest)
        print indent BOLD YELLOW marker RESET " " inline_highlight(rest)
        next
    }

    # 普通段落
    print inline_highlight(rawline)
}

# ─── 特殊斜体（行首 / "|" 之后的 *...*）────────────────────
function italic_special(str,    out, i, len, ch, j, next_ch, content) {
    out = ""; len = length(str)
    i = 1
    while (i <= len) {
        ch = substr(str, i, 1)
        if (ch == "*") {
            if (i == 1 || substr(str, i-1, 1) == "|") {
                j = i + 1
                while (j <= len && substr(str, j, 1) != "*") j++
                if (j <= len && j > i + 1) {
                    next_ch = (j == len) ? "" : substr(str, j+1, 1)
                    if (j == len || next_ch != "|") {
                        content = substr(str, i+1, j-i-1)
                        out = out P_ITALIC content P_RESET
                        i = j + 1
                        continue
                    }
                }
            }
        }
        out = out ch
        i++
    }
    return out
}

# ─── 智能代码还原：正确继承外层样式并关闭代码样式 ──────────
function expand_code(str, code_arr, cnt,    i, tag, start, prefix, j, ch, active, replace) {
    for (i = 0; i < cnt; i++) {
        tag = P_CODE_MARK i P_CODE_MARK
        while ((start = index(str, tag)) > 0) {
            prefix = substr(str, 1, start-1)
            active = ""
            for (j = length(prefix); j > 0; j--) {
                ch = substr(prefix, j, 1)
                if (ch == P_RESET) break
                if (index(STYLE_START_MARKS, ch) != 0)
                    active = ch active
            }
            replace = active P_DIM P_YELLOW code_arr[i] P_RESET active
            str = substr(str, 1, start-1) replace substr(str, start+length(tag))
        }
    }
    return str
}

# ─── 内联高亮引擎 ──────────────────────────────────────
function inline_highlight(str,    cnt, code_arr, left, mid, right, text, url, alt, \
                                  alt_start, alt_end, text_start, text_end, url_start, url_end) {
    # 1. 提取并保护所有行内代码
    cnt = 0
    while (match(str, /`[^`]+`/)) {
        code_arr[cnt] = substr(str, RSTART+1, RLENGTH-2)
        str = substr(str, 1, RSTART-1) P_CODE_MARK cnt P_CODE_MARK substr(str, RSTART+RLENGTH)
        cnt++
    }

    # 2. 图片 ![...](...)
    while (match(str, /!\[[^]]*\]\([^)]*\)/)) {
        left  = substr(str, 1, RSTART-1)
        mid   = substr(str, RSTART, RLENGTH)
        right = substr(str, RSTART+RLENGTH)
        alt_start = index(mid, "[") + 1
        alt_end   = index(mid, "]") - 1
        alt = substr(mid, alt_start, alt_end - alt_start + 1)
        url_start = index(mid, "(") + 1
        url_end   = index(mid, ")") - 1
        url = substr(mid, url_start, url_end - url_start + 1)
        str = left P_BOLD P_RED "IMAGE:" P_RESET P_UNDERLINE alt P_RESET \
              P_DIM "(" P_CYAN url P_RESET P_DIM ")" P_RESET right
    }

    # 3. 链接 [...](...) → OSC 8 超链接 + 下划线
    while (match(str, /\[[^]]*\]\([^)]*\)/)) {
        left  = substr(str, 1, RSTART-1)
        mid   = substr(str, RSTART, RLENGTH)
        right = substr(str, RSTART+RLENGTH)
        text_start = index(mid, "[") + 1
        text_end   = index(mid, "]") - 1
        text = substr(mid, text_start, text_end - text_start + 1)
        url_start = index(mid, "(") + 1
        url_end   = index(mid, ")") - 1
        url = substr(mid, url_start, url_end - url_start + 1)

        # 如果不是以 https:// 开头，补上基础 URL
        if (url !~ /^https:\/\//) {
            url = "https://mabbs.github.io" url
        }

        str = left P_UNDERLINE ESC "]8;;" url ESC "\\" text ESC "]8;;" ESC "\\" P_RESET right
    }

    # 4. 粗体 **...** 和 __...__
    while (match(str, /\*\*[^*]+\*\*/)) {
        left  = substr(str, 1, RSTART-1)
        mid   = substr(str, RSTART+2, RLENGTH-4)
        right = substr(str, RSTART+RLENGTH)
        str = left P_BOLD P_YELLOW mid P_RESET right
    }
    while (match(str, /__[^_]+__/)) {
        left  = substr(str, 1, RSTART-1)
        mid   = substr(str, RSTART+2, RLENGTH-4)
        right = substr(str, RSTART+RLENGTH)
        str = left P_BOLD P_YELLOW mid P_RESET right
    }

    # 5. 特殊斜体（行首 / 表格上下文）
    str = italic_special(str)

    # 6. 普通斜体 *...*
    while (match(str, /\*[^*]+\*/)) {
        left  = substr(str, 1, RSTART-1)
        mid   = substr(str, RSTART+1, RLENGTH-2)
        right = substr(str, RSTART+RLENGTH)
        str = left P_ITALIC mid P_RESET right
    }

    # 7. 删除线 ~~...~~
    while (match(str, /~~[^~]+~~/)) {
        left  = substr(str, 1, RSTART-1)
        mid   = substr(str, RSTART+2, RLENGTH-4)
        right = substr(str, RSTART+RLENGTH)
        str = left P_STRIKE P_DIM P_RED mid P_RESET right
    }

    # 8. 智能还原代码（带样式继承）
    if (cnt > 0)
        str = expand_code(str, code_arr, cnt)

    # 9. 占位符 → 真实 ANSI
    gsub(P_RESET,     RESET,     str)
    gsub(P_BOLD,      BOLD,      str)
    gsub(P_DIM,       DIM,       str)
    gsub(P_ITALIC,    ITALIC,    str)
    gsub(P_UNDERLINE, UNDERLINE, str)
    gsub(P_STRIKE,    STRIKE,    str)
    gsub(P_RED,       RED,       str)
    gsub(P_GREEN,     GREEN,     str)
    gsub(P_YELLOW,    YELLOW,    str)
    gsub(P_BLUE,      BLUE,      str)
    gsub(P_MAGENTA,   MAGENTA,   str)
    gsub(P_CYAN,      CYAN,      str)
    gsub(P_WHITE,     WHITE,     str)

    return str
}